{
  "name": "2ndbrain-ceo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-duckdb.cjs",
    "dev": "node server/custom-server.js",
    "prebuild": "node scripts/prepare-duckdb.cjs",
    "build": "next build",
    "start": "node server/custom-server.js",
    "start:standalone": "node .next/standalone/server.js",
    "start:next": "next start",
    "typecheck": "tsc --noEmit",
    "test:chat": "node --test tests/chat-api.test.cjs tests/chat-credits.test.cjs tests/chat-attachments.test.cjs tests/chat-usage-api.test.cjs",
    "test:solana": "node --test tests/solana-rpc.test.cjs",
    "admin:load": "node scripts/load-admin-users.mjs",
    "db:migrate": "bash scripts/apply-migrations.sh",
    "schema:check": "node scripts/check-schema-drift.mjs",
    "wiki:backfill": "node scripts/backfill-wiki-graph.mjs",
    "wiki:backfill-content": "node scripts/backfill-wiki-content.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@solana/web3.js": "^1.98.4",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "buffer": "^6.0.3",
    "clawmacdo": "^0.93.0",
    "clsx": "latest",
    "cytoscape": "^3.33.3",
    "cytoscape-fcose": "^2.2.0",
    "exceljs": "^4.4.0",
    "lucide-react": "latest",
    "mammoth": "^1.12.0",
    "next": "^16.4.3",
    "pdf-parse": "^2.4.5",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/yauzl": "^3.4.0",
    "typescript": "latest"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@solana/web3.js": {
      "jayson": "5.0.0"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=26.12.1 <27"
  }
