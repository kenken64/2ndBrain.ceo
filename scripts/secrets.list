# Canonical list of server-side (runtime) Docker secrets.
# Single source of truth for scripts/init-secrets.sh and docker-compose.secrets.yml.
# Format:  NAME:kind
#   generate -> a strong random value is created if missing (openssl rand -hex 32)
#   provide  -> a real value is required; imported from .env if present, else left empty
#   optional -> like provide, but may stay empty (feature simply stays disabled)
#
# NOTE: NEXT_PUBLIC_* values are intentionally NOT here. They are inlined into the
# browser bundle at build time and are not secret.

# --- Generated shared secrets (32-byte hex) ---
OPENCLAW_SSH_TOKEN_SECRET:generate
GYNE_AGENT_SESSION_SECRET:generate
PSLE_ENG_TUTOR_SESSION_SECRET:generate
MOBILE_DEVICE_OPERATOR_SESSION_SECRET:generate
NEWS_INTELLIGENCE_DESK_SESSION_SECRET:generate
MARKETPLACE_LAUNCH_VERIFY_SECRET:generate
MARKETPLACE_RENEWAL_SECRET:generate
INSTANCE_REAPER_SECRET:generate

# --- Values you must supply ---
SUPABASE_SERVICE_ROLE_KEY:provide
AWS_ACCESS_KEY_ID:provide
AWS_SECRET_ACCESS_KEY:provide
OPENAI_API_KEY:provide

# --- Optional (leave empty to disable the feature) ---
OPENROUTER_API_KEY:optional
GWS_OAUTH_CLIENT_SECRET:optional
TOKEN_QUOTA_REDIS_URL:optional
SOLANA_RPC_URL:optional
